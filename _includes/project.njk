---
layout: page.njk
---
<div class="project-main">
  <h2>{{ title }}</h2>

  <ul id="proj-details">
    <li>{{ launch }}</li>
    {% if purl %}
    <li><a href="//{{ purl }}">{{ purl }}</a></li>
    {% endif %}
    <li>{{ tech }}</li>
  </ul>

  <div id="proj-desc">
    {{ content | safe }}
  </div>

  <div id="proj-imgs">
    <div class="proj-shots">
      {% for file, alt in shots %}
      <img src="/images/{{ pid }}/{{ file }}" alt="{{ alt }}"
        eleventy:widths="480,800,auto"
        sizes="(min-width: 40rem) 85vw, 94vw"
        {% if loop.first %}loading="eager"{% endif %}>
      {% endfor %}
    </div>

    {% if mobiles %}
    <div class="proj-mobiles">
      {% for file, alt in mobiles %}
      <img src="/images/{{ pid }}/{{ file }}" alt="{{ alt }}">
      {% endfor %}
    </div>
    {% endif %}
  </div>
</div>
